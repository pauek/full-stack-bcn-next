{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js: debug server-side (BACKEND=files)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "env": {
                "BACKEND": "files"
            }
        },
        {
            "name": "Next.js: debug server-side (BACKEND=db)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "env": {
                "BACKEND": "db"
            }
        },
        {
            "name": "Next.js: debug client-side",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Next.js: debug full-stack (BACKEND=files)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "env": {
                "BACKEND": "files"
            },
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "- Local:.+(https?://.+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}"
            }
        },
        {
            "name": "Next.js: debug full-stack (BACKEND=db)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "env": {
                "BACKEND": "db"
            },
            "serverReadyAction": {
                "action": "debugWithChrome",
                "killOnServerStop": true,
                "pattern": "- Local:.+(https?://.+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}"
            }
        }
    ]
}
